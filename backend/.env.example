# Legacy local profile. Set your own database account before running setup.py.
# setup.py generates an encryption key for a new .env. Preserve any existing key.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace_with_local_database_user
DB_PASSWORD=
# Separate database; the original attendance_system tables are preserved.
DB_NAME=attendance_proposal_xampp
DEMO_MODE=false
FYP_ACCOUNT_BOUND_ENROLLMENT=false
APP_TIMEZONE=Asia/Kuala_Lumpur
SESSION_HOURS=8
CHALLENGE_SECONDS=90
FACE_DISTANCE_THRESHOLD=0.45
BIOMETRIC_KEY=
